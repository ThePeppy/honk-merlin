#!/bin/sh
# Merlin avahi owns UDP 5353, so honk cannot bind that port. 5354 is the
# loopback DNS upstream dial_mode uses to learn the domain for an IP.
CONFIG=$1
[ -n "$CONFIG" ] || exit 0
if [ -f /usr/sbin/helper.sh ]; then
  . /usr/sbin/helper.sh
  pc_delete "servers-file=" "$CONFIG"
  # avoid duplicate server lines on repeated runs
  pc_delete "server=127.0.0.1#5353" "$CONFIG"
  pc_delete "server=127.0.0.1#5354" "$CONFIG"
  pc_append "server=127.0.0.1#5354" "$CONFIG"
else
  sed -i '/^servers-file=/d' "$CONFIG"
  sed -i '/^server=127.0.0.1#5353$/d' "$CONFIG"
  sed -i '/^server=127.0.0.1#5354$/d' "$CONFIG"
  echo 'server=127.0.0.1#5354' >> "$CONFIG"
fi
